#!/bin/sh
# postrm script for kratheos-food-data.
#
# Nothing under /var/lib/kratheos-food-data is ever removed, not even on
# purge: live.sqlite is the only copy of what users entered since the last
# export. The settings file is a dpkg conffile, removed by dpkg on purge.

set -e

case "$1" in
    purge)
        if [ -d /var/lib/kratheos-food-data ]; then
            echo "kratheos-food-data: the data are kept in /var/lib/kratheos-food-data (remove them by hand if they are no longer needed)."
        fi
    ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#
