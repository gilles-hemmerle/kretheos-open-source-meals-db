# Never committed: the large source files (attached to releases instead), the
# files prepared for a release, the intermediate work files and the built
# database. `make build` rebuilds the last two.
mirror/
release/
work/
dist/

# An interrupted download or join, anywhere.
*.part
*.part.json
*.joining

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Editors and operating system
.DS_Store
.idea/
.vscode/
