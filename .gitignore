# Never committed: the large source files (attached to releases instead), the
# files prepared for a release, the intermediate work files and the built
# database. `make build` rebuilds the last two.
mirror/
release/
work/
dist/

# Never committed either: the data of a service run from this directory (the
# main database it serves, its live database with the hashed contributor
# keys and the reports), and what is laid out to publish a built database.
data/
release-database/

# An interrupted download or join, anywhere.
*.part
*.part.json
*.joining

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Editors and operating system
.DS_Store
.idea/
.vscode/

# The settings of compose.yml on this host (the data directory, the user).
.env
